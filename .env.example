GEMINI_API_KEY=your-key-here
PORT=3000
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest
# Optional: seconds to skip a model after a 429/503 (default 60, max 300, 0 = off).
GEMINI_COOLDOWN_SECONDS=60
STAFF_PASSWORD=your-staff-password-here
# Orders can be placed ONLY when this is exactly the word true. Unset or anything else = demo mode (orders disabled).
ORDERS_ENABLED=false

# Optional extra AI provider (OpenAI-compatible, for example Groq or OpenRouter). Used only AFTER all Gemini models fail.
# It is switched on only when ALL THREE of these are filled in; otherwise it is off.
# Base URL of the provider's OpenAI-compatible API (https only). Example for Groq: https://api.groq.com/openai/v1
EXTRA_AI_BASE_URL=
# The provider's API key (placeholder only here: put the real one in your own .env).
EXTRA_AI_API_KEY=
# Model IDs, comma separated, tried in this order. Copy the exact IDs from the provider's Models page.
EXTRA_AI_MODELS=
