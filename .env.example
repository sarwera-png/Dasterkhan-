GEMINI_API_KEY=your-key-here
PORT=3000
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest
# Optional: seconds to skip a model after a 429/503 (default 60, max 300, 0 = off).
GEMINI_COOLDOWN_SECONDS=60
STAFF_PASSWORD=your-staff-password-here
# Orders can be placed ONLY when this is exactly the word true. Unset or anything else = demo mode (orders disabled).
ORDERS_ENABLED=false
